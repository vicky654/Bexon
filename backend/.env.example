DATABASE_URL="file:../data/dev.db"
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
PORT=5000
CORS_ORIGIN=http://localhost:3001,http://localhost:4000

# Required once the backend and admin app are deployed on separate domains:
# the admin auth cookie only gets SameSite=None; Secure (needed for a
# cross-site cookie to be sent/accepted by browsers) when NODE_ENV is
# "production". Leave unset for local dev (same-site, different ports).
NODE_ENV=production

# Optional, deferred until you're ready to send real emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Consent portal — sends the contact-form OTP by email and records the
# visitor's consent. Leave CONSENT_API_BASE blank to turn OTP off (the form
# then saves and emails submissions directly, as before).
CONSENT_API_BASE=
CONSENT_JWT_SECRET=
CONSENT_JWT_ISS=
CONSENT_JWT_AUD=
CONSENT_JWT_EMAIL=
CONSENT_DEPARTMENT=Contact Us

# Which proxies to trust for the visitor's IP (Express "trust proxy").
# "loopback" suits the Next.js site and backend running on the same machine;
# set to your host's proxy (e.g. 1) if they run elsewhere.
# Production: the Next.js site must sit behind a proxy/CDN that overwrites
# X-Real-IP (or appends to X-Forwarded-For). Otherwise visitors can spoof
# their IP and bypass the per-IP limit on OTP emails.
TRUST_PROXY=loopback

# Circuit breaker: maximum contact-form OTP emails the portal will be asked
# to send across all visitors in a rolling hour, shared by /start and
# /resend. Optional, default 100.
CONTACT_GLOBAL_SEND_CAP=

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) for the contact form.
# Leave blank to skip the check. Google's public test keys only work for
# local testing — replace them before going live.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Optional, deferred until you're ready to enable the "Generate with AI"
# buttons in the Blog and Job admin forms. Get a key from
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
