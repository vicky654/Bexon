DATABASE_URL="file:../data/dev.db"
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
PORT=5000
CORS_ORIGIN=http://localhost:3001

# Required once the backend and admin app are deployed on separate domains:
# the admin auth cookie only gets SameSite=None; Secure (needed for a
# cross-site cookie to be sent/accepted by browsers) when NODE_ENV is
# "production". Leave unset for local dev (same-site, different ports).
NODE_ENV=production

# Optional, deferred until you're ready to send real emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
