# SMTP credentials used by src/app/api/contact/route.js to send contact form emails.
# Copy this file to .env.local and fill in real values (never commit .env.local).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Optional: defaults to SMTP_USER when omitted.
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=you@example.com
